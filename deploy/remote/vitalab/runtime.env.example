# Portable runtime defaults copied to <VITALAB_ROOT>/config/runtime.env.
# This file is intentionally non-secret. Put API keys in
# <VITALAB_ROOT>/secrets/api.env on the server.

COMPOSE_PROJECT_NAME=vitalab
VITALAB_COMPOSE_PROFILES=quick-tunnel
REMOTE_BIND_HOST=127.0.0.1

QDRANT_IMAGE=qdrant/qdrant:v1.14.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

ENZYME_API_IMAGE=vitalab-api:local
ENZYME_API_HOST=0.0.0.0
ENZYME_API_PORT=18001
ENZYME_RUNTIME_CONFIG=/app/config/remote.yaml
ENZYME_API_CORS_ORIGINS=null,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8001,http://localhost:8001,https://shengji-enzyme-rag-lab.pages.dev

SHENGJI_WEB_PORT=5173
MINERU_PORT=8000

HF_HOME=/app/model_cache
SENTENCE_TRANSFORMERS_HOME=/app/model_cache/sentence-transformers

INGESTION_POLL_SECONDS=10
INGESTION_MINERU_TIMEOUT_SECONDS=1800
INGESTION_MINERU_INTERVAL_SECONDS=10
INGESTION_QDRANT_BATCH_SIZE=64
INGESTION_COLLECTION=

TUNNEL_MODE=quick
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_CONFIG=/etc/cloudflared/config.yaml

CLOUDFLARE_PAGES_URL=https://shengji-enzyme-rag-lab.pages.dev
CLOUDFLARE_KV_NAMESPACE_TITLE=vitalab-origin-registry
CLOUDFLARE_KV_ORIGIN_KEY=current_backend_origin
ALLOWED_BACKEND_HOST_SUFFIXES=.trycloudflare.com

SENTINEL_INTERVAL_SECONDS=30
SENTINEL_HEALTH_TIMEOUT_SECONDS=10
SENTINEL_TUNNEL_RESTART_WAIT_SECONDS=8
SENTINEL_PAGES_HEALTH_TIMEOUT_SECONDS=90
SENTINEL_LOG_TAIL=200
