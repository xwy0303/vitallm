# Portable deployment inventory. Copy this file outside git or to a
# non-secret target-specific file before deploying.

VITALAB_HOST="10.7.117.30"
VITALAB_USER="gjsk"
VITALAB_SSH_PORT="22"
VITALAB_ROOT="/home/gjsk/project/vitalab"

# auto, linux, or macos. auto runs `uname -s` on the remote host.
VITALAB_REMOTE_OS="auto"

# Optional SSH config file. Leave empty to use Host/User/Port above.
VITALAB_SSH_CONFIG=""

# Docker Compose project/runtime.
VITALAB_COMPOSE_PROJECT="vitalab"
VITALAB_COMPOSE_PROFILES="quick-tunnel"
VITALAB_RUNTIME_ENV="config/runtime.env"

# Sync controls. Keep artifact sync explicit to avoid shipping the whole repo.
SYNC_DELETE="true"
SYNC_INCLUDE_PDFS="false"
SYNC_ARTIFACT_PATHS="artifacts/rag_inputs artifacts/evidence artifacts/ingestion_registry artifacts/indexing"

# Public bridge. quick keeps using a temporary trycloudflare URL. named requires
# a Cloudflare-controlled domain and named tunnel credentials/token.
TUNNEL_MODE="quick"
CLOUDFLARE_PAGES_URL="https://shengji-enzyme-rag-lab.pages.dev"
CLOUDFLARE_KV_NAMESPACE_TITLE="vitalab-origin-registry"
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_KV_ORIGIN_KEY="current_backend_origin"
ALLOWED_BACKEND_HOST_SUFFIXES=".trycloudflare.com"
CLOUDFLARE_INITIAL_BACKEND_ORIGIN=""
